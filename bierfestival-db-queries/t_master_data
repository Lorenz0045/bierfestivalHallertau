CREATE TABLE beer_type (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(100) NOT NULL
);

CREATE TABLE brewery (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    city VARCHAR(255),
    region VARCHAR(255),
    is_hallertau BOOLEAN DEFAULT false,
    website VARCHAR(255)
);

CREATE TABLE beer (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    brewery_id BIGINT REFERENCES brewery(id) ON DELETE CASCADE,
    beer_type_id BIGINT REFERENCES beer_type(id) ON DELETE SET NULL,
    alcohol_percentage DECIMAL(4,2),
    original_gravity DECIMAL(4,2),
    is_non_alcoholic BOOLEAN DEFAULT false,
    description VARCHAR(150),
    rating_count INT DEFAULT 0,
    rating_average DECIMAL(3,2) DEFAULT 0.00
);

CREATE TABLE sponsor (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    city VARCHAR(255),
    website VARCHAR(255),
    description VARCHAR(150)
);

-- POI (Points of Interest) Tables with Map Coordinates

CREATE TABLE tavern (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    img_url VARCHAR(500),
    lat DOUBLE PRECISION,
    lon DOUBLE PRECISION
);

CREATE TABLE tavern_beer (
    tavern_id BIGINT REFERENCES tavern(id) ON DELETE CASCADE,
    beer_id BIGINT REFERENCES beer(id) ON DELETE CASCADE,
    PRIMARY KEY (tavern_id, beer_id)
);

CREATE TABLE gastronomy (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    city VARCHAR(255),
    category VARCHAR(100),
    website VARCHAR(255),
    lat DOUBLE PRECISION,
    lon DOUBLE PRECISION
);

CREATE TABLE stage (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    lat DOUBLE PRECISION,
    lon DOUBLE PRECISION
);

CREATE TABLE event (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    start_time TIMESTAMP NOT NULL,
    end_time TIMESTAMP NOT NULL,
    day_name VARCHAR(50),
    description VARCHAR(150),
    stage_id BIGINT REFERENCES stage(id) ON DELETE CASCADE
);

-- Simple POIs
CREATE TABLE facility (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    type VARCHAR(50) NOT NULL, -- e.g., 'WC', 'OFFICE', 'BUS_STOP'
    name VARCHAR(255) NOT NULL,
    lat DOUBLE PRECISION,
    lon DOUBLE PRECISION
);


-- Changes
ALTER TABLE facility_type DROP COLUMN IF EXISTS icon_name;
ALTER TABLE facility_type ADD COLUMN img_url VARCHAR(500);

ALTER TABLE facility ADD COLUMN img_url VARCHAR(500);

ALTER TABLE brewery ADD COLUMN img_url VARCHAR(500);
ALTER TABLE sponsor ADD COLUMN img_url VARCHAR(500);
ALTER TABLE stage ADD COLUMN img_url VARCHAR(500);

CREATE TABLE gastronomy_type (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(100) NOT NULL
);

ALTER TABLE gastronomy DROP COLUMN category;
ALTER TABLE gastronomy ADD COLUMN gastronomy_type_id BIGINT REFERENCES gastronomy_type(id) ON DELETE SET NULL;
ALTER TABLE gastronomy ADD COLUMN img_url VARCHAR(500);

DROP TABLE IF EXISTS tavern_beer;

CREATE TABLE tavern_beer (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    tavern_id BIGINT REFERENCES tavern(id) ON DELETE CASCADE,
    beer_id BIGINT REFERENCES beer(id) ON DELETE CASCADE,
    sort_order INT NOT NULL DEFAULT 0
);



CREATE TABLE user_beer_interaction (
    id BIGSERIAL PRIMARY KEY,
    device_id VARCHAR(255) NOT NULL,
    beer_id BIGINT NOT NULL,
    is_on_merkliste BOOLEAN DEFAULT FALSE,
    merkliste_added_at TIMESTAMP(6) WITH TIME ZONE,
    rating INTEGER,
    rated_at TIMESTAMP(6) WITH TIME ZONE,
    CONSTRAINT fk_beer_interaction FOREIGN KEY (beer_id) REFERENCES beer(id) ON DELETE CASCADE,
    CONSTRAINT uq_device_beer UNIQUE (device_id, beer_id)
);

CREATE TABLE user_drink_event (
    id BIGSERIAL PRIMARY KEY,
    device_id VARCHAR(255) NOT NULL,
    beer_id BIGINT NOT NULL,
    consumed_at TIMESTAMP(6) WITH TIME ZONE NOT NULL,
    CONSTRAINT fk_beer_drink FOREIGN KEY (beer_id) REFERENCES beer(id) ON DELETE CASCADE
);


CREATE INDEX idx_ubi_device_id ON user_beer_interaction(device_id);
CREATE INDEX idx_ude_device_id ON user_drink_event(device_id);


-- Migration: beer.description auf TEXT umstellen für mehrzeilige Beschreibungen
ALTER TABLE beer ALTER COLUMN description TYPE TEXT;

-- Handwerkermarkt (Craft Market)
CREATE TABLE craft_market (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    description TEXT,
    website VARCHAR(255),
    city VARCHAR(255),
    img_url VARCHAR(500),
    lat DOUBLE PRECISION,
    lon DOUBLE PRECISION
);